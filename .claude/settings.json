{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(go get:*)",
      "Bash(go install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
