# Binaries
#
# The binary shares its name with cmd/claude-repo-factory, so these two
# patterns must stay anchored to the repository root. Unanchored, they match
# at any depth and silently exclude the entry point directory itself, which
# builds fine locally and then fails on a fresh clone.
/bin/
/dist/
/claude-repo-factory
/claude-repo-factory.exe
*.exe
*.dll
*.so
*.dylib

# Test and coverage output
*.test
*.out
coverage.txt
coverage.html

# Go workspace files
go.work
go.work.sum

# Editors and IDEs
.idea/
.vscode/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db

# Local Claude Code state (project config under .claude IS committed)
.claude/settings.local.json

# Scratch output from manual CLI runs
/tmp/
/scratch/
